---
// Compact hero: a title and one line of tagline, so the page reaches its
// content quickly. The primary actions live in the site header, and the
// principle panel renders further down the page via PrinciplePanel.astro.
---

<section class="zs-hero">
  <div class="zs-hero__copy">
    <h1 class="zs-hero__title" id="_top" data-page-title>
      {`${Astro.locals.t('zs.hero.titleLine1')} ${Astro.locals.t('zs.hero.titleLine2')}`}
    </h1>
    <p class="zs-hero__tagline">{Astro.locals.t('zs.hero.tagline')}</p>
  </div>
</section>

<style>
  .zs-hero {
    padding-block: var(--zi-space-3) var(--zi-space-2);
  }

  /* display-1: the one landing title. */
  .zs-hero__title {
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--zi-ink);
    margin: 0 0 var(--zi-space-3);
    border: none;
    padding: 0;
    text-wrap: balance;
  }

  .zs-hero__tagline {
    font-size: 1rem;
    line-height: 1.6875rem;
    color: var(--zi-ink-muted);
    margin: 0;
    max-inline-size: 72ch;
  }

  .zs-hero__tagline strong {
    color: var(--zi-ink);
    font-weight: 600;
  }
</style>
