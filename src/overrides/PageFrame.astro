---
// PageFrame override: injects the site-wide promotional announcement bar
// above Starlight's fixed nav header.
import Default from '@astrojs/starlight/components/PageFrame.astro';
import type { Props } from '@astrojs/starlight/props';
import { CLOUD_REGISTER_URL, localePathPrefix } from '../data/site';
import { getActiveNotice } from '../data/notices';
import ConsentBanner from './ConsentBanner.astro';

const notice = getActiveNotice();
const localePrefix = localePathPrefix(Astro.locals.starlightRoute.locale);
const noticeHref = notice?.path ? `${localePrefix}/${notice.path}` : undefined;
---

{
  /* Prevent FOUC: runs synchronously before paint.
    The notice window is evaluated at build time, since the site builds
    statically. A notice that has not started yet is simply not rendered, so it
    cannot leak early. One that has ended would otherwise keep showing until the
    next deploy, so endsAt is re-checked here against the visitor's clock. */
}
<script
  is:inline
  define:vars={{ noticeId: notice?.id ?? null, noticeEndsAt: notice?.endsAt ?? null }}
>
  if (sessionStorage.getItem('zs-promo-dismissed') === '1') {
    document.documentElement.setAttribute('data-promo-dismissed', '');
  }

  if (noticeId && sessionStorage.getItem('zs-notice-dismissed') === noticeId) {
    document.documentElement.setAttribute('data-notice-dismissed', '');
  }

  if (noticeEndsAt && Date.now() > Date.parse(noticeEndsAt)) {
    document.documentElement.setAttribute('data-notice-dismissed', '');
  }
</script>

{/* Reserve layout space for the notice bar only while one is showing. */}
{notice && <style is:inline set:html=":root { --zs-notice-height: 2.5rem; }" />}

<div id="promo-bar" class="promo-bar" role="region" aria-label={Astro.locals.t('zs.promo.label')}>
  <div class="promo-inner">
    <span class="promo-live" aria-label={Astro.locals.t('zs.promo.liveLabel')}>
      <span class="live-dot" aria-hidden="true"></span>
      {Astro.locals.t('zs.promo.live')}
    </span>
    <span class="promo-sep" aria-hidden="true">·</span>
    <span class="promo-text">{Astro.locals.t('zs.promo.credit')}</span>
    <span class="promo-sep" aria-hidden="true">·</span>
    <span class="promo-text">{Astro.locals.t('zs.promo.ends')}</span>
  </div>
  <span class="promo-sep promo-sep--cta" aria-hidden="true">·</span>
  <a href={CLOUD_REGISTER_URL} class="promo-cta" target="_blank" rel="noopener noreferrer">
    {Astro.locals.t('zs.promo.cta')}
  </a>
  <button
    id="promo-dismiss"
    class="promo-dismiss"
    type="button"
    aria-label={Astro.locals.t('zs.promo.dismiss')}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
</div>

{
  notice && (
    <div
      id="notice-bar"
      class="notice-bar"
      data-severity={notice.severity}
      role="region"
      aria-label={Astro.locals.t('zs.notice.label')}
    >
      <div class="notice-inner">
        <span class="notice-label">{Astro.locals.t(notice.labelKey)}</span>
        <span class="notice-sep" aria-hidden="true">
          ·
        </span>
        <span class="notice-text">{Astro.locals.t(notice.textKey)}</span>
        {noticeHref && notice.linkKey && (
          <a href={noticeHref} class="notice-link">
            {Astro.locals.t(notice.linkKey)}
          </a>
        )}
      </div>
      <button
        id="notice-dismiss"
        class="notice-dismiss"
        type="button"
        data-notice-id={notice.id}
        aria-label={Astro.locals.t('zs.notice.dismiss')}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  )
}

<Default {...Astro.props}>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
</Default>

{
  /* Rendered here, outside Starlight's main pane, on purpose. The main pane sets
     isolation: isolate, so a fixed element inside it can never rise above the
     sidebar or header, whatever its z-index. */
}
<ConsentBanner />

<div
  id="sidebar-resizer"
  class="sidebar-resizer"
  role="separator"
  aria-orientation="vertical"
  aria-label={Astro.locals.t('zs.resize.sidebar')}
  tabindex="0"
>
</div>

<div
  id="toc-resizer"
  class="toc-resizer"
  role="separator"
  aria-orientation="vertical"
  aria-label={Astro.locals.t('zs.resize.toc')}
  tabindex="0"
>
</div>

<script>
  document.getElementById('promo-dismiss')?.addEventListener('click', () => {
    sessionStorage.setItem('zs-promo-dismissed', '1');
    document.documentElement.setAttribute('data-promo-dismissed', '');
  });

  const noticeDismiss = document.getElementById('notice-dismiss');
  noticeDismiss?.addEventListener('click', () => {
    // Key the dismissal on the notice id so a revised notice shows again.
    sessionStorage.setItem('zs-notice-dismissed', noticeDismiss.dataset.noticeId ?? '1');
    document.documentElement.setAttribute('data-notice-dismissed', '');
  });

  // ── Resizable layout (left sidebar + right TOC) ─────────────
  // Each handle drives a CSS custom property; the content column (main-pane)
  // is flex: 1 in custom.css, so it absorbs whatever space the sidebar or TOC
  // gives up. The handles reposition themselves via CSS (left/right bound to
  // the same variables), so we only need to update the variable.
  const root = document.documentElement;
  const remPerPx = () => 1 / parseFloat(getComputedStyle(root).fontSize);
  const STEP_PX = 10; // keyboard arrow step

  interface Handle {
    el: HTMLElement | null;
    cssVar: string;
    storageKey: string;
    min: number;
    max: number;
    invertKeys: boolean;
    fromEvent: (e: MouseEvent) => number;
  }

  function initHandle(h: Handle) {
    if (!h.el) return;
    let px = 0;

    const apply = (value: number) => {
      px = Math.min(Math.max(value, h.min), h.max);
      root.style.setProperty(h.cssVar, `${(px * remPerPx()).toFixed(3)}rem`);
    };
    // localStorage can throw in private mode / when storage is disabled —
    // guard it so the resize feature never breaks the page.
    const persist = () => {
      try {
        localStorage.setItem(h.storageKey, String(px));
      } catch {
        /* storage unavailable — ignore */
      }
    };

    let saved = NaN;
    try {
      saved = Number(localStorage.getItem(h.storageKey));
    } catch {
      /* storage unavailable — ignore */
    }
    if (Number.isFinite(saved) && saved > 0) apply(saved);

    let dragging = false;
    h.el.addEventListener('mousedown', (e: MouseEvent) => {
      dragging = true;
      document.body.style.cursor = 'col-resize';
      document.body.style.userSelect = 'none';
      e.preventDefault();
    });
    document.addEventListener('mousemove', (e: MouseEvent) => {
      if (dragging) apply(h.fromEvent(e));
    });
    document.addEventListener('mouseup', () => {
      if (!dragging) return;
      dragging = false;
      document.body.style.cursor = '';
      document.body.style.userSelect = '';
      persist();
    });
    h.el.addEventListener('keydown', (e: KeyboardEvent) => {
      const dir = e.key === 'ArrowLeft' ? -1 : e.key === 'ArrowRight' ? 1 : 0;
      if (!dir) return;
      apply(px + dir * STEP_PX * (h.invertKeys ? -1 : 1));
      persist();
      e.preventDefault();
    });
  }

  // Left sidebar: handle on the sidebar's right edge; dragging right widens it.
  initHandle({
    el: document.getElementById('sidebar-resizer'),
    cssVar: '--sl-sidebar-width',
    storageKey: 'zs-sidebar-width',
    min: 180,
    max: 480,
    invertKeys: false,
    fromEvent: (e) => e.clientX,
  });

  // Right TOC: handle on the TOC's left edge; dragging left widens it.
  initHandle({
    el: document.getElementById('toc-resizer'),
    cssVar: '--toc-width',
    storageKey: 'zs-toc-width',
    min: 192,
    max: 448,
    invertKeys: true,
    fromEvent: (e) => window.innerWidth - e.clientX,
  });
</script>

<style>
  /* Both bars are plain surface-raised strips with a hairline, like the
     header. The notice tone shows on its label only, with the word. */

  /* The notice bar sits between the promo bar and the fixed header. Its height
     feeds --sl-announcement-height in custom.css, which is what pushes the
     header and content down, so both bars can be shown or dismissed freely. */
  .notice-bar {
    --zs-notice-tone: var(--zi-warning);
    position: fixed;
    inset-inline: 0;
    inset-block-start: var(--zs-promo-height, 2.5rem);
    z-index: 9998;
    height: var(--zs-notice-height, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--zi-space-4) var(--zi-space-12);
    gap: var(--zi-space-3);
    background-color: var(--zi-surface-raised);
    border-bottom: 1px solid var(--zi-line);
    color: var(--zi-ink);
  }

  .notice-bar[data-severity='danger'] {
    --zs-notice-tone: var(--zi-danger);
  }

  .notice-bar[data-severity='info'] {
    --zs-notice-tone: var(--zi-accent);
  }

  :root[data-notice-dismissed] .notice-bar {
    display: none;
  }

  .notice-inner,
  .promo-inner {
    display: flex;
    align-items: center;
    gap: var(--zi-space-2);
    font-size: 0.8125rem;
    flex-wrap: nowrap;
    flex: 0 1 auto;
    min-inline-size: 0;
    max-inline-size: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .notice-inner::-webkit-scrollbar,
  .promo-inner::-webkit-scrollbar {
    display: none;
  }

  .notice-label,
  .promo-live {
    font-family: var(--zi-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .notice-label {
    color: var(--zs-notice-tone);
  }

  .notice-sep,
  .promo-sep {
    color: var(--zi-ink-faint);
    flex-shrink: 0;
  }

  .notice-text,
  .promo-text {
    white-space: nowrap;
    color: var(--zi-ink-muted);
  }

  .notice-link,
  .promo-cta {
    color: var(--zi-accent) !important;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none !important;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color var(--zi-transition);
  }

  .notice-link:hover,
  .promo-cta:hover {
    color: var(--zi-accent-hover) !important;
    text-decoration: underline !important;
    text-underline-offset: 2px;
  }

  .notice-dismiss,
  .promo-dismiss {
    position: absolute;
    inset-inline-end: var(--zi-space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--zi-space-1);
    background: transparent;
    border: 0;
    border-radius: var(--zi-radius-sm);
    color: var(--zi-ink-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition:
      color var(--zi-transition),
      background-color var(--zi-transition);
  }

  .notice-dismiss:hover,
  .promo-dismiss:hover {
    color: var(--zi-ink);
    background-color: var(--zi-surface);
  }

  .promo-bar {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: 9999;
    height: var(--zs-promo-height, 2.5rem);
    background-color: var(--zi-surface-raised);
    border-bottom: 1px solid var(--zi-line);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--zi-space-4) var(--zi-space-12);
    gap: var(--zi-space-3);
  }

  :root[data-promo-dismissed] .promo-bar {
    display: none;
  }

  /* Status tag: a static 6px dot in the status colour before the word. */
  .promo-live {
    display: flex;
    align-items: center;
    gap: var(--zi-space-1);
    color: var(--zi-ink);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--zi-success);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .notice-bar,
    .promo-bar {
      justify-content: flex-start;
      padding-inline: var(--zi-space-4) 2.75rem;
    }

    .notice-inner,
    .promo-inner {
      flex: 1 1 auto;
    }

    /* The CTA is pinned outside the scroller, so the separator that used to
       precede it would read as trailing punctuation on truncated text. */
    .promo-sep--cta {
      display: none;
    }
  }
</style>
