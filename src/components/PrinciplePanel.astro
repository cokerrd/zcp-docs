---
// The ZSoftly principle panel. It used to sit beside the hero; it now renders
// further down the home page, so the top of the page can get to the content.
---

<section class="zs-principle" aria-label={Astro.locals.t('zs.hero.quoteLabel')}>
  <div class="zs-hero__quote">
    <div class="zs-hero__quote-inner">
      <div class="zs-hero__quote-mark" aria-hidden="true">"</div>
      <blockquote>{Astro.locals.t('zs.hero.quote')}</blockquote>
      <div class="zs-hero__quote-meta">
        <span class="zs-hero__quote-rule"></span>
        <span class="zs-hero__quote-source">{Astro.locals.t('zs.hero.quoteSource')}</span>
      </div>
      <ul class="zs-hero__pillars">
        <li>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
          >
          {Astro.locals.t('zs.hero.pillarSovereignty')}
        </li>
        <li>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="10"></circle><path
              d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"
            ></path></svg
          >
          {Astro.locals.t('zs.hero.pillarLockIn')}
        </li>
        <li>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg
          >
          {Astro.locals.t('zs.hero.pillarInfrastructure')}
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .zs-principle {
    margin-bottom: var(--zi-space-12);
  }

  @media (min-width: 60rem) {
    .zs-principle .zs-hero__quote-inner {
      max-inline-size: none;
    }
  }

  /* Plain panel: hairline on surface-raised, no glow and no tint. */
  .zs-hero__quote-inner {
    padding: var(--zi-space-6);
    border-radius: var(--zi-radius-lg);
    border: 1px solid var(--zi-line);
    background: var(--zi-surface-raised);
  }

  .zs-hero__quote-mark {
    font-family: var(--zi-font-mono);
    font-size: 2rem;
    line-height: 1;
    color: var(--zi-ink-faint);
    margin-bottom: var(--zi-space-2);
    user-select: none;
  }

  .zs-hero__quote-inner blockquote {
    font-size: 1rem;
    line-height: 1.6875rem;
    color: var(--zi-ink);
    margin: 0 0 var(--zi-space-4);
    border: none;
    padding: 0;
    quotes: none;
    max-inline-size: 72ch;
  }

  .zs-hero__quote-meta {
    display: flex;
    align-items: center;
    gap: var(--zi-space-2);
    margin-bottom: var(--zi-space-4);
  }

  .zs-hero__quote-rule {
    display: inline-block;
    width: 1.25rem;
    height: 1px;
    background: var(--zi-line-strong);
    flex-shrink: 0;
  }

  .zs-hero__quote-source {
    font-family: var(--zi-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--zi-ink-faint);
  }

  .zs-hero__pillars {
    list-style: none;
    padding: var(--zi-space-4) 0 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--zi-space-2);
    border-top: 1px solid var(--zi-line);
  }

  .zs-hero__pillars li {
    display: flex;
    align-items: center;
    gap: var(--zi-space-2);
    font-size: 0.875rem;
    color: var(--zi-ink-muted);
  }

  .zs-hero__pillars svg {
    flex-shrink: 0;
    color: var(--zi-accent);
  }
</style>
